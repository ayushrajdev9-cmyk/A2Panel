APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://panel.test
APP_INSTALLED=false
APP_LOCALE=en

# ---- Security ----
# Set to '*' to trust your reverse proxy (cloudflare tunnel / nginx).
# WARNING: only use '*' if the proxy is the ONLY network path to this server.
TRUSTED_PROXIES=
# Force secure (HTTPS) cookies when behind a TLS-terminating proxy.
SESSION_SECURE_COOKIE=true
# Comma separated list of hosts allowed for stateful (cookie-based) API auth.
SANCTUM_STATEFUL_DOMAINS=
# Only log errors and fatal issues in production.
APP_LOG_LEVEL=error
